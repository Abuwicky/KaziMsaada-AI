# Local setup:
#   1. Copy this file to .streamlit/secrets.toml
#   2. Replace the placeholder with your own Google AI Studio API key
#   3. Restart Streamlit
#
# Streamlit Community Cloud:
#   Manage app -> Settings -> Secrets
#   Paste the blocks below, save, and reboot the app.
#
# Never commit .streamlit/secrets.toml or a real API key.

# ---------------------------------------------------------------------------
# Public deployment authentication
# ---------------------------------------------------------------------------
# On Streamlit Community Cloud the app fails closed and requires sign-in even
# when this block is absent. For other public hosts, set require_auth = true
# and configure an OpenID Connect provider. Local desktop use can leave both
# sections commented out.
#
# [app]
# require_auth = true
# environment = "cloud"
#
# [auth]
# redirect_uri = "https://your-app.streamlit.app/oauth2callback"
# cookie_secret = "replace-with-a-long-random-cookie-secret"
# client_id = "your-oidc-client-id"
# client_secret = "your-oidc-client-secret"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ---------------------------------------------------------------------------
# Optional AI practice provider
# ---------------------------------------------------------------------------
[ai]
provider = "GoogleAiStudio"
model = "gemini-2.5-flash"
api_key = "replace-with-your-google-ai-studio-key"
timeout_seconds = 20
max_output_chars = 4000

# ---------------------------------------------------------------------------
# Mentor Meeting Centre administrator access
# ---------------------------------------------------------------------------
# Use a long random value. Do not reuse an AI provider key.
# The app never treats the active profile selector as administrator security.
[mentor_admin]
access_code = "replace-with-a-long-random-administrator-code"
# Stronger option: store only a PBKDF2 hash instead of the plain code.
# Generate one with:
#   python -c "from core.mentor_access import hash_access_code; print(hash_access_code('your-code'))"
# access_code_hash = "pbkdf2_sha256$240000$..."
